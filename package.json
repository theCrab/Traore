{
    "name": "Traore",
    "version": "1.0.0",
    "description": "High-performance OTP Authentication API utilizing strict TDD, Postgres, and Redis",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "dev": "tsx watch src/server.js",
        "test": "jest --runInBand --detectOpenHandles",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "<rootDir>/tests/**/*.test.ts"
        ],
        "transform": {
            "^.+\\.tsx?$": [
                "ts-jest",
                {
                    "tsconfig": "<rootDir>/tsconfig.test.json"
                }
            ]
        }
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "ioredis": "^5.5.0",
        "pg": "^8.13.3",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@jest/globals": "^30.5.2",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.13.5",
        "@types/pg": "^8.11.11",
        "@types/supertest": "^6.0.2",
        "eslint": "^10.13.0",
        "jest": "^29.7.0",
        "prettier": "^3.9.10",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.6",
        "tsx": "^4.19.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1"
    }
}
